{
  "esm": "0.8.0",
  "metadata": {"name": "AdvInterior", "description": "Interior-only centered advection (faces held at a constant source, no state reads at faces): every band is an affine offset, so the structure classifies as banded."},
  "index_sets": {"x": {"kind": "interval", "size": 8}},
  "models": {
    "Adv": {
      "variables": {
        "u": {"type": "state", "shape": ["x"], "default": 0.3},
        "c": {"type": "parameter", "default": 1.5},
        "dx": {"type": "parameter", "default": 0.25}
      },
      "equations": [
        {"lhs": {"op": "D", "args": ["u"], "wrt": "t"},
         "rhs": {"op": "makearray", "args": [],
           "regions": [[[2, 7]], [[1, 1]], [[8, 8]]],
           "values": [
             {"op": "aggregate", "output_idx": ["i"], "args": ["u"],
              "ranges": {"i": [2, 7]},
              "expr": {"op": "*", "args": [{"op": "-", "args": ["c"]},
                {"op": "/", "args": [
                  {"op": "-", "args": [
                    {"op": "index", "args": ["u", {"op": "+", "args": ["i", 1]}]},
                    {"op": "index", "args": ["u", {"op": "-", "args": ["i", 1]}]}]},
                  {"op": "*", "args": [2, "dx"]}]}]}},
             0.0,
             0.0
           ]}}
      ]
    }
  }
}
