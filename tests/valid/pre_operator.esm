{
 "esm": "1.1.0",
 "metadata": {
  "name": "PreOperator",
  "description": "`Pre` in a right-hand side (esm-spec \u00a75.1 gives it a meaning of its own only in an event affect): EarthSciAST evaluates Pre(x) as x, so its derivative is d[x] (spec \u00a73.2), never 0. Pre of an indexed array state inside a faq body, Pre of a scalar state read by every cell, Pre of one cell read by a scalar equation, and a state read both through Pre and directly, so its band's coefficient sums both reads. Linear in every Pre read, so no coefficient carries a Pre (earthsci-ast for Python does not evaluate one)."
 },
 "index_sets": {
  "x": {
   "kind": "interval",
   "size": 3
  }
 },
 "models": {
  "PreOperator": {
   "variables": {
    "a": {
     "type": "unknown",
     "shape": [
      "x"
     ],
     "default": 0.5
    },
    "b": {
     "type": "unknown",
     "default": 0.2
    },
    "k": {
     "type": "parameter",
     "default": 0.5
    }
   },
   "equations": [
    {
     "lhs": {
      "op": "D",
      "args": [
       "a"
      ],
      "wrt": "t"
     },
     "rhs": {
      "op": "faq",
      "args": [],
      "output_idx": [
       "i"
      ],
      "ranges": {
       "i": {
        "from": "x"
       }
      },
      "expr": {
       "op": "+",
       "args": [
        {
         "op": "*",
         "args": [
          -1,
          "k",
          {
           "op": "Pre",
           "args": [
            {
             "op": "index",
             "args": [
              "a",
              "i"
             ]
            }
           ]
          }
         ]
        },
        {
         "op": "*",
         "args": [
          0.1,
          {
           "op": "Pre",
           "args": [
            "b"
           ]
          }
         ]
        }
       ]
      }
     }
    },
    {
     "lhs": {
      "op": "D",
      "args": [
       "b"
      ],
      "wrt": "t"
     },
     "rhs": {
      "op": "+",
      "args": [
       {
        "op": "Pre",
        "args": [
         {
          "op": "index",
          "args": [
           "a",
           1
          ]
         }
        ]
       },
       {
        "op": "*",
        "args": [
         -1,
         "k",
         {
          "op": "Pre",
          "args": [
           "b"
          ]
         }
        ]
       },
       {
        "op": "*",
        "args": [
         -0.5,
         "b"
        ]
       }
      ]
     }
    }
   ]
  }
 }
}
