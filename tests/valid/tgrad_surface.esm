{
  "esm": "2.0.0",
  "metadata": {
    "name": "TgradSurface",
    "description": "A time-dependent source that exists only at the surface (a makearray region one cell thick along lev), divided by the bottom layer's pressure thickness delP, an observed computed per level (as a regridded emission over the surface layer's air mass): its time companion reads delP at level 1, so it is a makearray over that region, never a whole-shape faq gated by the level (spec \u00a74.2)."
  },
  "index_sets": {
    "x": {
      "kind": "interval",
      "size": 3
    },
    "lev": {
      "kind": "interval",
      "size": 4
    }
  },
