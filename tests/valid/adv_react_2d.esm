{
  "esm": "1.0.0",
  "metadata": {"name": "AdvReact2D", "description": "prototype fixture: centered lon advection (zero-grad faces) + nonlinear pointwise chemistry on a 5x3 grid"},
  "index_sets": {"lon": {"kind": "interval", "size": 5}, "lat": {"kind": "interval", "size": 3}},
  "models": {
    "AdvReact": {
      "variables": {
        "c": {"type": "unknown", "shape": ["lon", "lat"], "default": 0.5},
        "d": {"type": "unknown", "shape": ["lon", "lat"], "default": 0.2},
        "dx": {"type": "parameter", "default": 2.5},
        "k":  {"type": "parameter", "default": 0.7},
        "s":  {"type": "parameter", "default": 0.1},
        "e":  {"type": "unknown", "default": 1.0}
      },
      "equations": [
        {
          "lhs": {"op": "D", "args": ["c"], "wrt": "t"},
          "rhs": {"op": "+", "args": [
            {"op": "makearray", "args": [],
             "regions": [[[2, 4], [1, 3]], [[1, 1], [1, 3]], [[5, 5], [1, 3]]],
             "values": [
               {"op": "aggregate", "output_idx": ["i", "j"], "args": ["c"],
                "ranges": {"i": [2, 4], "j": {"from": "lat"}},
                "expr": {"op": "/", "args": [
                  {"op": "-", "args": [
                    {"op": "index", "args": ["c", {"op": "+", "args": ["i", 1]}, "j"]},
                    {"op": "index", "args": ["c", {"op": "-", "args": ["i", 1]}, "j"]}]},
                  {"op": "*", "args": [2, "dx"]}]}},
               {"op": "aggregate", "output_idx": ["j"], "args": ["c"],
                "ranges": {"j": {"from": "lat"}},
                "expr": {"op": "/", "args": [
                  {"op": "-", "args": [{"op": "index", "args": ["c", 2, "j"]}, {"op": "index", "args": ["c", 1, "j"]}]}, "dx"]}},
               {"op": "aggregate", "output_idx": ["j"], "args": ["c"],
                "ranges": {"j": {"from": "lat"}},
                "expr": {"op": "/", "args": [
                  {"op": "-", "args": [{"op": "index", "args": ["c", 5, "j"]}, {"op": "index", "args": ["c", 4, "j"]}]}, "dx"]}}
             ]},
            {"op": "aggregate", "output_idx": ["i", "j"], "args": ["c", "d"],
             "ranges": {"i": {"from": "lon"}, "j": {"from": "lat"}},
             "expr": {"op": "*", "args": [-1, "k", {"op": "index", "args": ["c", "i", "j"]}, {"op": "index", "args": ["d", "i", "j"]}, "e"]}}
          ]}
        },
        {
          "lhs": {"op": "D", "args": ["d"], "wrt": "t"},
          "rhs": {"op": "aggregate", "output_idx": ["i", "j"], "args": ["c", "d"],
             "ranges": {"i": {"from": "lon"}, "j": {"from": "lat"}},
             "expr": {"op": "+", "args": [
               {"op": "*", "args": [-1, "k", {"op": "index", "args": ["c", "i", "j"]}, {"op": "index", "args": ["d", "i", "j"]}]},
               {"op": "*", "args": ["s", {"op": "exp", "args": [{"op": "*", "args": [-1, {"op": "index", "args": ["d", "i", "j"]}]}]}]},
               {"op": "max", "args": [{"op": "index", "args": ["c", "i", "j"]}, {"op": "index", "args": ["d", "i", "j"]}]}
             ]}}
        },
        {
          "lhs": {"op": "D", "args": ["e"], "wrt": "t"},
          "rhs": {"op": "*", "args": [-1, "k", "e", "e"]}
        }
      ]
    }
  }
}
